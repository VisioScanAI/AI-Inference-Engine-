from fastapi import FastAPI, UploadFile, File, HTTPException
from io import BytesIO
from PIL import Image
import numpy as np
import zipfile
import tempfile

from inference_engine.models.cnn_ensemble import CNNEnsemble
from inference_engine.models.unet3d import UNet3D
from inference_engine.models.utils import load_dicom_series
import torch
import os
import inference_engine.kernels.cuda_module as cuda_mod

app = FastAPI(title="VISIOSCAN AI Inference")

# Initialize models (paths to pretrained weights)
CXR_MODEL_PATHS = ["models/cxr_model1.pt", "models/cxr_model2.pt"]
HEAD_CT_MODEL_PATH = "models/unet3d_headct.pt"

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
cnn_ensemble = CNNEnsemble(CXR_MODEL_PATHS, device)
unet3d = UNet3D().to(device)
unet3d.load_state_dict(torch.load(HEAD_CT_MODEL_PATH, map_location=device))
unet3d.eval()

@app.post("/infer/cxr")
async def infer_cxr(file: UploadFile = File(...)):
    try:
        img = Image.open(BytesIO(await file.read())).convert('RGB')
        scores = cnn_ensemble.predict(img)
        return {"scores": scores.tolist()}
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))

@app.post("/infer/head_ct")
async def infer_head_ct(zip_file: UploadFile = File(...)):
    try:
        # Save uploaded zip
        tmp = tempfile.NamedTemporaryFile(delete=False, suffix='.zip')
        tmp.write(await zip_file.read()); tmp.close()
        vol = load_dicom_series(tmp.name)
        # CUDA-accelerated preproc example
        cuda_mod.scale(vol, 1.0/4095.0)
        x = torch.from_numpy(vol).unsqueeze(0).to(device)  # [1,1,D,H,W]
        with torch.no_grad():
            mask = unet3d(x).cpu().numpy()[0,0]
        return {"mask_shape": mask.shape, "mask": mask.tolist()}
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))

