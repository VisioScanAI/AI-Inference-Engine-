import torch
import torch.nn as nn

# Basic 3D U-Net skeleton
class DoubleConv(nn.Module):
    def __init__(self, in_c, out_c):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv3d(in_c, out_c, 3, padding=1),
            nn.BatchNorm3d(out_c),
            nn.ReLU(inplace=True),
            nn.Conv3d(out_c, out_c, 3, padding=1),
            nn.BatchNorm3d(out_c),
            nn.ReLU(inplace=True)
        )
    def forward(self, x): return self.net(x)

class UNet3D(nn.Module):
    def __init__(self, in_ch=1, out_ch=1, features=[32,64,128]):
        super().__init__()
        self.downs = nn.ModuleList()
        self.ups = nn.ModuleList()
        # Down
        for f in features:
            self.downs.append(DoubleConv(in_ch, f))
            in_ch = f
            self.downs.append(nn.MaxPool3d(2))
        # Up
        for f in reversed(features):
            self.ups.append(nn.ConvTranspose3d(in_ch, f, 2, stride=2))
            self.ups.append(DoubleConv(in_ch, f))
            in_ch = f
        self.bottleneck = DoubleConv(features[-1], features[-1]*2)
        self.final = nn.Conv3d(features[0], out_ch, 1)

    def forward(self, x):
        skip_connections = []
        for i in range(0, len(self.downs), 2):
            x = self.downs[i](x)
            skip_connections.append(x)
            x = self.downs[i+1](x)
        x = self.bottleneck(x)
        skip_connections = skip_connections[::-1]
        for idx in range(0, len(self.ups), 2):
            x = self.ups[idx](x)
            skip = skip_connections[idx//2]
            x = torch.cat((skip, x), dim=1)
            x = self.ups[idx+1](x)
        return torch.sigmoid(self.final(x))

