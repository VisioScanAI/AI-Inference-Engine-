extern "C" __global__ void scale_kernel(float* data, int N, float factor) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < N) data[idx] *= factor;
}

--- inference_engine/kernels/cuda_module.cpp ---
#include <pybind11/pybind11.h>
#include <pybind11/numpy.h>
#include <cuda_runtime.h>

namespace py = pybind11;

void run_scale(py::array_t<float> array, float factor) {
    auto buf = array.request();
    float* ptr = static_cast<float*>(buf.ptr);
    int N = buf.size;
    float* d_ptr;
    cudaMalloc(&d_ptr, N * sizeof(float));
    cudaMemcpy(d_ptr, ptr, N * sizeof(float), cudaMemcpyHostToDevice);
    int threads = 256;
    int blocks = (N + threads - 1) / threads;
    scale_kernel<<<blocks, threads>>>(d_ptr, N, factor);
    cudaMemcpy(ptr, d_ptr, N * sizeof(float), cudaMemcpyDeviceToHost);
    cudaFree(d_ptr);
}

PYBIND11_MODULE(cuda_module, m) {
    m.def("scale", &run_scale, "Scale array in-place by factor via CUDA");
}

