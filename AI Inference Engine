import os
import zipfile
import numpy as np
import pydicom

def load_dicom_series(zip_path):
    """Extracts and loads a DICOM series from a zip file into a NumPy 3D array."""
    temp_dir = zip_path + '_tmp'
    with zipfile.ZipFile(zip_path, 'r') as z:
        z.extractall(temp_dir)
    files = [os.path.join(temp_dir, f) for f in sorted(os.listdir(temp_dir)) if f.endswith('.dcm')]
    slices = [pydicom.dcmread(f).pixel_array for f in files]
    volume = np.stack(slices, axis=0)[None, ...]  # shape: [1, D, H, W]
    return volume.astype(np.float32)

